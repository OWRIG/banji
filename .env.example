# 复制成 .env 后按需修改。不创建 .env 也能直接运行（本地开发），会使用下面这些默认值。
PORT=3000
DATABASE_URL=data/app.db

# 默认只允许本机访问。想让同一局域网里的手机访问，改成 0.0.0.0
HOST=127.0.0.1

# 每日自动备份的目录和保留份数。本地部署建议放到「文稿」里，随 iCloud 同步，例如：
# BACKUP_DIR=/Users/你的用户名/Documents/班级工作台备份
BACKUP_DIR=data/backups
BACKUP_KEEP=30

# 登录功能（上线运行 pnpm start 时必填）
# 密钥：运行 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成
BETTER_AUTH_SECRET=
# 浏览器里访问这个系统的地址，必须完全一致，例如 http://localhost:3000
BETTER_AUTH_URL=
# 还会用其他地址访问时（手机用局域网 IP、Tailscale 地址），写在这里，逗号分隔
TRUSTED_ORIGINS=
